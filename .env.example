# Optional Gemini API key; keep this only in the backend environment.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_SECONDS=20
CHAT_RATE_LIMIT_PER_MINUTE=20

# Configure once for first Super Admin sign-in, then remove the password value.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=Initial Super Administrator
RESET_URL_BASE=http://127.0.0.1:5173/reset-password

# Optional authorized live BMTC feed.
BMTC_LIVE_API_URL=
BMTC_LIVE_API_KEY=

# Optional SMTP email delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Optional Web Push VAPID keys.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VITE_VAPID_PUBLIC_KEY=

# Optional SMS and WhatsApp providers.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Government radar scheduling.
RADAR_MONITOR_ENABLED=false
RADAR_INTERVAL_HOURS=6
SOURCE_MONITOR_ENABLED=false
SOURCE_MONITOR_INTERVAL_HOURS=12

# Local development defaults.
CIVIC_DB_PATH=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://civic-pulse-360-1.onrender.com
VITE_API_BASE=http://127.0.0.1:8000/api
# VITE_API_URL is also accepted for compatibility with common Vite setups.
# Keep exactly one of these values in frontend/.env.local when overriding the default.
